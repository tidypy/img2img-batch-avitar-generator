# Copy this file to .env and fill in your values.
# Get a token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# --- Optional overrides (CLI flags take precedence) ---
# Replicate model in owner/name:version format
REPLICATE_MODEL=stability-ai/sdxl:39ed52f2a78e934b3ba6e2a89f5b1c712de7dfea535525255b1aa35c5565e08b

INPUT_DIR=input_images
OUTPUT_DIR=output_avatars

# STYLE_PROMPT=highly detailed flat vector art illustration, pop art style, professional cartoon illustration, masterpiece, clean lines.
# NEGATIVE_PROMPT=blurry, low quality, deformed, watermark, text

# 0.0 = keep original image, 1.0 = ignore original image
PROMPT_STRENGTH=0.6
GUIDANCE_SCALE=7.5
NUM_INFERENCE_STEPS=30
NUM_OUTPUTS=1
MAX_IMAGE_SIDE=1024

# Rate-limit handling
MAX_RETRIES=5
RETRY_BASE_DELAY=5
REQUEST_DELAY=1
