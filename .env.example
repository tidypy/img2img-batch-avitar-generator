# Copy this file to .env and fill in your values. NEVER commit .env.
# Get an API key at https://nanobnana.com
NANO_BANANA_API_KEY=your_api_key_here

# --- Optional overrides (CLI flags take precedence) ---
NANO_BANANA_MODEL=nano2
# NANO_BANANA_API_BASE=https://nanobnana.com

INPUT_DIR=input_images
OUTPUT_DIR=output_avatars

# STYLE_PROMPT=highly detailed flat vector art illustration, pop art style, professional cartoon illustration, masterpiece, clean lines, solid background.
ASPECT_RATIO=1:1
RESOLUTION=1K
MAX_IMAGE_SIDE=1536

# The API only accepts public image URLs. By default local images are uploaded
# to a temporary host (litterbox.catbox.moe) that auto-deletes them.
UPLOAD_EXPIRY=1h
# Or, if your images are already hosted, set the base URL and uploads are skipped:
# PUBLIC_IMAGE_BASE_URL=https://my-bucket.s3.amazonaws.com/input_images

# Polling & rate-limit handling
POLL_INTERVAL=3
POLL_TIMEOUT=300
MAX_RETRIES=5
RETRY_BASE_DELAY=5
REQUEST_DELAY=1
